---
import ImageMod from "@/components/ImageMod.astro";
import TitleCenter from "@/components/TitleCenter.astro";
import ServiceAreaLocations from "@/components/ServiceAreaLocations.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import { render } from "astro:content";

import LeadForm from "@/layouts/components/LeadForm.astro";
export async function getStaticPaths() {
  const services = await getSinglePage("servicepage");

  const paths = services.map((service) => ({
    params: {
      single: service.id,
    },
    props: { service },
  }));
  return paths;
}

const { service } = Astro.props;
const { title, description, image, icon, contact_form } = service.data;
const { Content } = await render(service);

const allLocations = await getSinglePage("locationpage");
const servingLocations = allLocations.filter((loc) =>
  loc.data.services?.some((s) => s.slug === service.id)
);

const cityAreas = servingLocations.map((loc) => ({
  "@type": "City",
  "name": loc.data.city || "",
  "sameAs": `${config.site.base_url}/locations/${loc.id}`,
}));

const plainDescription = plainify(description);
const servicePricing = title.toLowerCase().includes("free") ? "0" : undefined;

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": title,
    "description": plainDescription,
    "url": `${config.site.base_url}/services/${service.id}`,
    ...(image && { "image": `${config.site.base_url}${image}` }),
    "provider": {
      "@type": "Organization",
      "name": "J Land Contracting",
      "telephone": "(410) 292-0801",
      "email": "info@jlandgroup.com",
      "url": config.site.base_url,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3636 Glenoble Court",
        "addressLocality": "Jefferson",
        "addressRegion": "MD",
        "postalCode": "21755",
        "addressCountry": "US"
      }
    },
    "serviceType": "Roofing Service",
    "areaServed": [
      { "@type": "State", "name": "Maryland" },
      { "@type": "AdministrativeArea", "name": "Washington County, Maryland" },
      { "@type": "AdministrativeArea", "name": "Frederick County, Maryland" },
      { "@type": "AdministrativeArea", "name": "Carroll County, Maryland" },
      { "@type": "AdministrativeArea", "name": "Baltimore County, Maryland" },
      { "@type": "AdministrativeArea", "name": "Harford County, Maryland" },
      { "@type": "AdministrativeArea", "name": "Baltimore City, Maryland" },
      { "@type": "AdministrativeArea", "name": "Howard County, Maryland" },
      { "@type": "AdministrativeArea", "name": "Montgomery County, Maryland" },
      { "@type": "AdministrativeArea", "name": "Prince George's County, Maryland" },
      { "@type": "AdministrativeArea", "name": "Anne Arundel County, Maryland" },
      {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": "39.3697",
          "longitude": "-77.5475"
        },
        "geoRadius": "80467"
      },
      ...cityAreas
    ],
    ...(servicePricing !== undefined && {
      "offers": {
        "@type": "Offer",
        "price": servicePricing,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      }
    })
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": config.site.base_url
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Services",
        "item": `${config.site.base_url}/services`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": title,
        "item": `${config.site.base_url}/services/${service.id}`
      }
    ]
  }
];

---

<Base {...service.data} schemaData={schemaData}>
  <section class="section-lg">
    <div class="container">
      {
        icon && (
          <div  >
            <ImageMod
              src={icon}
              alt=""
              class="w-15 h-15 mb-6 max-lg:mx-auto"
              aria-hidden="true"
              width={60}
              height={60}
            />
          </div>
        )
      }
      <TitleCenter title={title} description={description} as="h1" />

      <div class="relative">
        {
          image && (
           <div  >
             <ImageMod
              class="rounded-2xl lg:h-137 w-full object-cover mt-16"
              src={image}
              height={700}
              width={1300}
              alt={title}
              aria-hidden="true"
              format="webp"
            />
           </div>
          )
        }

        {
          contact_form && contact_form.enable && (
            <LeadForm formSource="Service Page" />
          )
        }

        <div   class="lg:pt-36 content">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <ServiceAreaLocations
    service_title={title}
    locations={servingLocations.map((loc) => ({
      id: loc.id,
      city: loc.data.city || "",
      state: loc.data.state || "",
    }))}
  />
</Base>
