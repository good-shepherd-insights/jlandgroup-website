---
import ImageMod from "@/components/ImageMod.astro";
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";

const { footer } = menu;
---

<style>
  /* Daniel, 2026-08-27: the small mark plus "JLAND GROUP" text is replaced by the
     full lockup, and the strapline underneath it is gone. */
  .footer__logo {
    display: block; margin: 0 auto; height: auto;
    width: min(clamp(320px, 52vw, 720px), 88vw);
  }
  .footer__brand { display: flex; justify-content: center; width: 100%; }
  /* Daniel, 2026-08-27: centre everything in the orange band and take the info up a size. */
  .masthead-none {}
  footer .container { text-align: center; }
  footer h3 { text-align: center; }
  footer ul { list-style: none; padding-left: 0; }
  footer li { text-align: center; }
  footer .footer__contact,
  footer .footer__contact * { text-align: center; }
</style>

<footer class="section pb-15 relative text-white overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0 bottom-0">
    <ImageMod
      src="/images/footer-bg.png"
      alt=""
      class="w-full h-full object-cover opacity-100 pointer-events-none"
      height={1000}
      width={2000}
      aria-hidden="true"
      loading={"lazy"}
    />
  </div>

  <div class="container relative z-10">
    <div
      class="footer__brand"
    >
      <a href="/" aria-label="JLand Group — home">
        <img
          class="footer__logo"
          src="/images/logo-jland-group-v5.png"
          alt="JLand Group — Contracting &amp; Restoration"
          width="1982" height="490"
          loading="lazy"
        />
      </a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="relative z-10 container py-16 lg:py-20">
    <!-- Right: Text + Menus -->
    <div class="space-y-10 lg:space-y-12">
      <div class="border-t border-white/20 pt-8 lg:pt-10">
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-10">
          <!-- Dynamic Menu Sections from menu.json -->
          {
            footer.map((section) => (
              <div>
                <h3 class="text-text-light mb-6 opacity-80 uppercase text-xl tracking-wider text-center">
                  {section.title}
                </h3>
                <ul class="space-y-5">
                  {section.children.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        class="text-text-light font-semibold text-2xl hover:text-text-dark transition-colors duration-300"
                      >
                        {item.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }

          <!-- Column 3: Contact Info -->
          <div class="space-y-8">
            <div>
              <h3
                class="text-text-light mb-2 opacity-80 text-xl tracking-wider text-center"
              >
                Call us:
              </h3>
              <a
                href={`tel:${config.contact_info.phone.replace(/[^+\d]/g, "")}`}
                class="text-text-light font-semibold text-2xl hover:text-text-dark transition-colors duration-300"
              >
                {config.contact_info.phone}
              </a>
            </div>

            <div>
              <h3
                class="text-text-light mb-2 opacity-80 text-xl tracking-wider text-center"
              >
                E-mail:
              </h3>
              <a
                href={`mailto:${config.contact_info.email}`}
                class="text-text-light font-semibold text-2xl hover:text-text-dark transition-colors duration-300"
              >
                {config.contact_info.email}
              </a>
            </div>

            <div>
              <h3
                class="text-text-light mb-2 opacity-80 text-xl tracking-wider text-center"
              >
                Address:
              </h3>
              <a
                href={`https://www.google.com/maps/place/${encodeURIComponent(config.contact_info.address)}`}
                class="text-text-light font-semibold hover:text-text-dark text-2xl leading-relaxed text-center"
                target="_blank"
                rel="noopener noreferrer"
              >
                {config.contact_info.address}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</footer>
