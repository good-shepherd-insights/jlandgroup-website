---
import Button from "@/components/Button.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";

const homepage = await getListPage("homepage", "-index");
const { banner } = homepage.data;
const phone = config.contact_info?.phone;
const telHref = "tel:+1" + (phone || "").replace(/\D/g, "");
---

<style>
  .hero { position: relative; min-height: 78vh; display: flex; align-items: center; overflow: hidden; padding-block: 4.5rem; }
  @media (max-width: 640px) { .hero { min-height: 70vh; padding-block: 3rem; } }

  .hero__media {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: 0;
  }
  /* Dark, even wash so white type stays legible over any frame of the footage. */
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, rgba(10,10,12,.78) 0%, rgba(10,10,12,.42) 46%, rgba(10,10,12,.88) 100%),
      radial-gradient(120% 80% at 50% 42%, rgba(0,0,0,0) 38%, rgba(8,8,10,.55) 100%);
  }
  /* Soft hand-off into the section below instead of a hard edge. */
  .hero::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 120px;
    z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(10,10,12,0) 0%, var(--hero-fade, #0b0b0d) 100%);
  }
  .hero__inner { position: relative; z-index: 2; width: 100%; text-align: center; }

  @media (max-width: 768px) {
    /* Give the lockup room to breathe under the sticky header, and keep it
       inside the text column instead of running to the screen edges. */
    .hero { padding-block: 3.5rem 2.5rem; min-height: 88vh; }
  }

  .hero__title {
    color: #fff;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.08;
    font-size: clamp(2rem, 5.2vw, 4rem);
    margin: 0 auto 1.25rem;
    max-width: 24ch;
  }
  .hero__title strong { font-weight: 600; }

  .hero__sub {
    color: rgba(255,255,255,.82);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 300;
    line-height: 1.6;
    max-width: 60ch;
    margin: 0 auto 2.5rem;
  }

  .hero__actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  /* Daniel, 2026-08-26: phone below the consultation button, larger and bolder. */
  .hero__tel {
    display: block; width: fit-content; margin: 1.9rem auto 0;
    color: #fff; text-decoration: none;
    font-size: clamp(2rem, 3.9vw, 3.15rem);
    font-weight: 800; letter-spacing: .002em;
    text-shadow: 0 3px 26px rgba(0,0,0,.7);
    transition: opacity .18s ease;
  }
  .hero__tel:hover { opacity: .85; }

  .hero__meta {
    margin: 2.75rem auto 0; max-width: 78rem;
    display: flex; gap: .6rem 2rem; justify-content: center; flex-wrap: wrap;
    color: rgba(255,255,255,.74);
    font-size: clamp(.7rem, 1.05vw, .8rem);
    letter-spacing: .13em; text-transform: uppercase; font-weight: 400;
  }
  .hero__meta span { position: relative; }
  .hero__meta span + span::before {
    content: ""; position: absolute; left: -1rem; top: 50%;
    width: 1px; height: 11px; transform: translateY(-50%);
    background: rgba(255,255,255,.28);
  }
  @media (max-width: 640px) {
    .hero__meta { gap: .5rem 1.4rem; margin-top: 2.25rem; }
    .hero__meta span + span::before { left: -.7rem; }
  }

  /* Respect reduced-motion and save mobile data: poster only, no video. */
  @media (prefers-reduced-motion: reduce) { .hero__media--video { display: none; } }
</style>

<section class="hero">
  <img class="hero__media" src="/video/hero-poster-v2.jpg" alt="" aria-hidden="true" />
  <video
    class="hero__media hero__media--video"
    autoplay muted loop playsinline preload="none"
    poster="/video/hero-poster-v2.jpg"
    aria-hidden="true"
    tabindex="-1"
  >
  </video>

  <div class="hero__scrim"></div>

  <div class="hero__inner">
    <div class="container">
      <h1 class="hero__title" data-editable="text" data-prop="banner.title" set:html={markdownify(banner.title)} />
      {banner.content && <p class="hero__sub" data-editable="text" data-prop="banner.content" set:html={markdownify(banner.content)} />}

      <div class="hero__actions">
        <Button data={banner.button_solid} />
        <Button data={banner.button_outline} variant="outline" />
      </div>

      <a class="hero__tel" href={telHref}>{phone}</a>

      <div class="hero__meta">
        <span>Roofing</span>
        <span>Siding</span>
        <span>Gutters</span>
        <span>Commercial / TPO / PVC / EPDM / Metal</span>
        <span>Windows &amp; Doors</span>
        <span>Restoration</span>
        <span>Contracting</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Only fetch the video once the hero is on screen and the device is not on a
  // small/metered viewport. Saves ~2.3MB for mobile visitors.
  document.addEventListener("astro:page-load", () => {
    const v = document.querySelector<HTMLVideoElement>(".hero__media--video");
    if (!v) return;

    // Someone who has asked their phone to save data gets the poster only.
    // Everyone else gets the loop — phones included, on a lighter encode.
    if ((navigator as any).connection?.saveData) { v.remove(); return; }

    const small = window.matchMedia("(max-width: 768px)").matches;
    const src = small ? "/video/hero-mobile-v2.mp4" : "/video/hero-v2.mp4";

    const source = document.createElement("source");
    source.src = src;
    source.type = "video/mp4";
    v.appendChild(source);

    v.preload = "auto";
    v.load();
    v.play().catch(() => {
      // iOS refuses autoplay until the element is genuinely muted+inline; retry once.
      v.muted = true;
      v.play().catch(() => {});
    });
  });
</script>
