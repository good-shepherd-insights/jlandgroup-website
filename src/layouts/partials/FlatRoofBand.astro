---
// Daniel, 2026-08-27: move the flat-roofing loop above the insurance section and
// sit it under the commercial pictures, full width.
---

<section class="flatband">
  <img class="flatband__poster" src="/video/flat-roof-poster-v1.jpg" alt="" aria-hidden="true" />
  <video
    class="flatband__video"
    autoplay muted loop playsinline preload="none"
    poster="/video/flat-roof-poster-v1.jpg"
    aria-hidden="true"
    tabindex="-1"
  ></video>
</section>

<style>
  .flatband { position: relative; width: 100%; height: 460px; overflow: hidden; background: #14161a; }
  .flatband__poster,
  .flatband__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .flatband__video { z-index: 1; }
  @media (prefers-reduced-motion: reduce) { .flatband__video { display: none; } }
  @media (max-width: 768px) { .flatband { height: 300px; } }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const v = document.querySelector<HTMLVideoElement>(".flatband__video");
    if (!v) return;
    if ((navigator as any).connection?.saveData) { v.remove(); return; }

    const small = window.matchMedia("(max-width: 768px)").matches;
    const source = document.createElement("source");
    source.src = small ? "/video/flat-roof-mobile-v1.mp4" : "/video/flat-roof-v1.mp4";
    source.type = "video/mp4";
    v.appendChild(source);

    const start = () => { v.preload = "auto"; v.load(); v.play().catch(() => { v.muted = true; v.play().catch(() => {}); }); };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { io.disconnect(); start(); }
      }, { rootMargin: "300px" });
      io.observe(v);
    } else { start(); }
  });
</script>
